    "test:navigation": "node scripts/test-navigation.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "framer-motion": "^14.4.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",

    "lint": "eslint .",
    "typecheck": "tsc -b",
    "images": "node scripts/images.mjs",
    "hero": "node scripts/hero-frames.mjs",
    "docs:bilder": "node scripts/gen-bilder-md.mjs",
    "docs:leistungsverzeichnis": "node scripts/leistungsverzeichnis.mjs",

    "@vitejs/plugin-react": "^5.2.0",
    "beasties": "^0.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-react-ssg": "^0.9.2"

ErrorDocument 404 /404.html
Options -Indexes
DirectorySlash On

<IfModule mod_rewrite.c>
  RewriteEngine On
  # https erzwingen
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # zusammengeführte Ortsseiten
  RewriteRule ^einzugsgebiet/ortenberg/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/durbach/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/hohberg/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/schutterwald/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/neuried/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/friesenheim/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/renchen/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/kappelrodeck/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/sasbach/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/lautenbach/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/oppenau/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/zell-am-harmersbach/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/biberach/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/hausach/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/seelbach/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/kippenheim/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/mahlberg/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/rust/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/schwanau/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/meissenheim/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/berghaupten/?$ /einzugsgebiet/ [L,R=301]
  RewriteRule ^einzugsgebiet/ohlsbach/?$ /einzugsgebiet/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(js|css|woff2|avif|webp|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
